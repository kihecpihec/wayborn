{
  "expo": {
    "name": "Wayborn \u00b7 Field Demo",
    "slug": "wayborn-field-demo",
    "owner": "ismar_m",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/wayborn-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.wayborn.fielddemo",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f3f4ee",
        "foregroundImage": "./assets/wayborn-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/wayborn-icon.png",
      "name": "Wayborn \u00b7 Field Demo"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wayborn uses your location to follow your walk and show your trail on OpenStreetMap."
        }
      ],
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "0bfd9468-d134-4fb5-872c-6eaf677f9b36"
      }
    },
    "scheme": "wayborn-field-demo"
  }
}
